# Environment variables for reproducible DAGE model runs
# Copy this file to `.env` and edit values as needed.
# `.env` itself is NOT committed to Git (see .gitignore).

# Random seed override (scripts use 1738 and 9499 internally)
# SEED=1738

# TensorFlow deterministic ops for stricter reproducibility
TF_DETERMINISTIC_OPS=1

# oneDNN can produce slightly different results across runs; disable for determinism
TF_ENABLE_ONEDNN_OPTS=0

# Disable GPU to avoid CUDA driver issues and improve reproducibility
CUDA_VISIBLE_DEVICES=-1

# Avoid .pyc clutter
PYTHONDONTWRITEBYTECODE=1
